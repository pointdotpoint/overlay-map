    public static func SetTiles(s: Int32, l: Int32) -> array<Int32> {
        switch s * 100 + l {
            case 2: return NMTileManifest.Tiles_0_2();
            case 3: return NMTileManifest.Tiles_0_3();
            case 4: return NMTileManifest.Tiles_0_4();
            case 5: return NMTileManifest.Tiles_0_5();
            case 100: return NMTileManifest.Tiles_1_0();
            case 101: return NMTileManifest.Tiles_1_1();
            case 102: return NMTileManifest.Tiles_1_2();
            case 103: return NMTileManifest.Tiles_1_3();
            case 104: return NMTileManifest.Tiles_1_4();
            case 105: return NMTileManifest.Tiles_1_5();
            case 200: return NMTileManifest.Tiles_2_0();
            case 201: return NMTileManifest.Tiles_2_1();
            case 202: return NMTileManifest.Tiles_2_2();
            case 203: return NMTileManifest.Tiles_2_3();
            case 204: return NMTileManifest.Tiles_2_4();
            case 205: return NMTileManifest.Tiles_2_5();
            case 300: return NMTileManifest.Tiles_3_0();
            case 301: return NMTileManifest.Tiles_3_1();
            case 302: return NMTileManifest.Tiles_3_2();
            case 303: return NMTileManifest.Tiles_3_3();
            case 304: return NMTileManifest.Tiles_3_4();
            case 305: return NMTileManifest.Tiles_3_5();
            case 400: return NMTileManifest.Tiles_4_0();
            case 401: return NMTileManifest.Tiles_4_1();
            case 402: return NMTileManifest.Tiles_4_2();
            case 403: return NMTileManifest.Tiles_4_3();
            case 404: return NMTileManifest.Tiles_4_4();
            case 405: return NMTileManifest.Tiles_4_5();
            default: break;
        }
        let empty: array<Int32>;
        return empty;
    }

