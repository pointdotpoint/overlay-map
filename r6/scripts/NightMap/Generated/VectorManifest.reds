    public static func LevelPoints(i: Int32) -> array<Int32> {
        switch i {
            case 0: return NMVectorManifest.LevelPoints_L0();
            case 1: return NMVectorManifest.LevelPoints_L1();
            case 2: return NMVectorManifest.LevelPoints_L2();
            case 3: return NMVectorManifest.LevelPoints_L3();
            case 4: return NMVectorManifest.LevelPoints_L4();
            default: break;
        }
        let empty: array<Int32>;
        return empty;
    }

}
