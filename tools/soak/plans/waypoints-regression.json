{
 "name": "waypoints-regression",
 "runs": [
  {
   "name": "all-plugin",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "native",
    "autopilot"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "selftest",
     "timeout": 60
    },
    {
     "wait": 3
    },
    {
     "cmd": "open"
    },
    {
     "wait": 4
    },
    {
     "cmd": "zoomloop z 100 5"
    },
    {
     "await_state": "mode_done_z",
     "timeout": 220,
     "shoot_on": "hold",
     "shoot_gap": 3.0,
     "max_changed": 100
    },
    {
     "cmd": "close"
    },
    {
     "wait": 2
    },
    {
     "cmd": "open"
    },
    {
     "wait": 3
    },
    {
     "cmd": "focus_ft far",
     "expect": "^ok"
    },
    {
     "wait": 1.5
    },
    {
     "cmd": "selected",
     "expect": "^ft"
    },
    {
     "cmd": "press teleport",
     "expect": "^pressed"
    },
    {
     "await_moved": 100,
     "timeout": 120
    },
    {
     "await_state": "ft_load_finished",
     "timeout": 60
    },
    {
     "await_visible": 60,
     "min_luma": 0.02
    },
    {
     "wait": 8
    },
    {
     "shot": "arrived",
     "min_luma": 0.02
    }
   ],
   "expect": [
    {
     "log": "TEST\\|SUMMARY",
     "min": 1
    },
    {
     "log": "fasttravel\\|start",
     "min": 1
    },
    {
     "log": "photo\\|store\\|loaded [1-9]",
     "min": 1
    }
   ],
   "forbid": [
    "TEST\\|FAIL\\|(tiles|chip|photo|route|grow|ft|tooltip)\\.",
    "tile pool exhausted"
   ]
  },
  {
