    {
     "cmd": "corner",
     "expect": "mpp 2"
    },
    {
     "shot": "after_close"
    },
    {
     "cmd": "wanted 2"
    },
    {
     "wait": 12
    },
    {
     "cmd": "mm_stealth"
    },
    {
     "cmd": "corner"
    },
    {
     "shot": "wanted"
    },
    {
     "cmd": "wanted 0"
    },
    {
     "wait": 3
    },
    {
     "padaxis": "LY",
     "value": 1.0
    },
    {
     "wait": 4.0
    },
    {
     "padaxis": "LY",
     "value": 0.0
    },
    {
     "wait": 1.0
    },
    {
     "cmd": "corner"
    },
    {
     "cmd": "mm_ctrls"
    },
    {
     "shot": "moved"
    },
    {
     "wait": 15
    },
    {
     "cmd": "set padopen view",
     "expect": "^padopen"
    },
    {
     "padhold": "VIEW",
     "seconds": 0.8
    },
    {
     "wait": 1.0
    },
    {
     "cmd": "is_open",
     "expect": "open"
    },
    {
     "shot": "pad_open"
    },
    {
     "pad": "B"
    },
    {
     "wait": 2.5
    },
    {
     "cmd": "is_open"
    },
    {
     "cmd": "corner",
     "expect": "^corner shown"
    },
    {
     "cmd": "vmark"
    },
    {
     "padaxis": "LY",
     "value": 1.0
    },
    {
     "wait": 2.0
    },
    {
     "padaxis": "LY",
     "value": 0.0
    },
    {
     "wait": 0.5
    },
    {
     "cmd": "vdist"
    },
    {
     "cmd": "corner_perf"
    },
    {
     "cmd": "set replace 0"
    },
    {
     "wait": 3
    },
    {
     "cmd": "corner",
     "expect": "^corner off"
    },
    {
     "shot": "off"
    }
   ]
  },
