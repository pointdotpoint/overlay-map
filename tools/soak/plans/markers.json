{
 "name": "markers",
 "runs": [
  {
   "name": "pan",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "open"
    },
    {
     "wait": 4
    },
    {
     "shot": "start"
    },
    {
     "cmd": "sweep a 1.0 30 8"
    },
    {
     "await_state": "sweep_done_a",
     "timeout": 120,
     "shoot_on": "hold"
    },
    {
     "cmd": "sweep b 2.0 20 4"
    },
    {
     "await_state": "sweep_done_b",
     "timeout": 90,
     "shoot_on": "hold"
    },
    {
     "cmd": "sweep d 0.5 15"
    },
    {
     "await_state": "sweep_done_d",
     "timeout": 60
    }
   ]
  }
 ]
}
