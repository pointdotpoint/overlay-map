{
 "name": "collect",
 "runs": [
  {
   "name": "pins",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot",
    "native"
   ],
   "repeats": 1,
   "expect": [
    {
     "log": "TEST\\|SUMMARY",
     "min": 1
    },
    {
     "log": "collect\\|built\\|",
     "min": 1
    }
   ],
   "forbid": [
    "TEST\\|FAIL\\|collect\\."
   ],
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "selftest",
     "timeout": 120
    },
    {
     "wait": 3
    },
    {
     "cmd": "open"
    },
    {
     "wait": 3
    },
    {
     "cmd": "collect",
     "expect": "spots 1862\\|"
    },
    {
     "cmd": "zoom 4"
    },
    {
     "wait": 2
    },
    {
     "shot": "c0_city"
    },
    {
     "cmd": "aim -1450 1250"
    },
    {
     "cmd": "zoom 1.5"
    },
    {
     "wait": 2
    },
    {
     "shot": "c1_watson"
    },
    {
     "cmd": "collect_focus 2",
     "expect": "^ok"
    },
    {
     "wait": 2
    },
    {
     "cmd": "selected",
     "expect": "^collect\\|ICONIC WEAPON"
    },
    {
     "shot": "c2_weapon"
    },
    {
     "cmd": "collect_seen Items.Preset_Achilles_Collectible",
     "expect": "layers \\d+v \\d+v \\d+v"
    },
    {
     "wait": 1
    },
    {
     "cmd": "selected",
     "expect": "^collect\\|ICONIC WEAPON\\|.*\\|Collected$"
    },
    {
     "shot": "c2b_weapon_struck"
    },
    {
     "cmd": "zoom 1"
    },
    {
     "wait": 1
    },
    {
     "shot": "c3_weapon_area"
    },
    {
     "cmd": "collect_focus 1",
     "expect": "^ok"
    },
    {
     "wait": 2
    },
    {
     "cmd": "selected",
     "expect": "^collect\\|TAROT"
    },
    {
     "shot": "c4_tarot"
    },
    {
     "cmd": "collect_focus 0",
     "expect": "^ok"
    },
    {
     "wait": 2
    },
    {
     "cmd": "selected",
     "expect": "^collect\\|SHARD"
    },
    {
     "shot": "c5_shard"
    },
    {
     "cmd": "close"
    },
    {
     "wait": 2
    }
   ]
  },
  {
   "name": "teleport",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot",
    "native"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "open"
    },
    {
     "wait": 2
    },
    {
     "cmd": "collect_focus 1",
     "expect": "^ok"
    },
    {
     "wait": 2
    },
    {
     "cmd": "selected",
     "expect": "^collect\\|TAROT"
    },
    {
     "key": "KP_Decimal"
    },
    {
     "wait": 4
    },
    {
     "shot": "t0a"
    },
    {
     "wait": 6
    },
    {
     "shot": "t0b"
    },
    {
     "wait": 6
    },
    {
     "cmd": "vpos",
     "expect": "hp 100"
    },
    {
     "shot": "t0c"
    }
   ],
   "expect": [
    {
     "log": "teleport\\|start\\|.*exact=true",
     "min": 1
    }
   ]
  },
  {
   "name": "police",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot",
    "native"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "wanted 2",
     "expect": "^wanted 2"
    },
    {
     "wait": 12
    },
    {
     "cmd": "police",
     "expect": "in map list [1-9]"
    },
    {
     "cmd": "open"
    },
    {
     "wait": 3
    },
    {
     "cmd": "zoom 1"
    },
    {
     "wait": 3
    },
    {
     "cmd": "police",
     "expect": "police [1-9]\\d*\\|dots [1-9]"
    },
    {
     "shot": "p0_police"
    },
    {
     "cmd": "zoom 0.6"
    },
    {
     "wait": 2
    },
    {
     "shot": "p1_police_close"
    },
    {
     "cmd": "close"
    },
    {
     "cmd": "wanted 0"
    },
    {
     "wait": 3
    }
   ]
  }
 ]
}
