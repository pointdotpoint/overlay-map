     "cmd": "vdist",
     "expect": "^still"
    },
    {
     "padup": "VIEW"
    },
    {
     "wait": 1.0
    },
    {
     "cmd": "is_open",
     "expect": "^closed"
    },
    {
     "wait": 1.0
    },
