{
 "name": "render",
 "runs": [
  {
   "name": "probe",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "selftest",
     "timeout": 60
    },
    {
     "wait": 3
    },
    {
     "cmd": "open"
    },
    {
     "wait": 4
    },
    {
     "cmd": "seed_photos 500"
    },
    {
     "wait": 2
    },
    {
     "cmd": "sweep a 1.0 20"
    },
    {
     "await_state": "sweep_done_a",
     "timeout": 60
    },
    {
     "cmd": "sweep b 2.0 12"
    },
    {
     "await_state": "sweep_done_b",
     "timeout": 60
    },
    {
     "cmd": "zoomloop z 120 8"
    },
    {
     "await_state": "mode_done_z",
     "timeout": 240,
     "shoot_on": "hold",
     "shoot_gap": 4.0
    }
   ]
  }
 ]
}
