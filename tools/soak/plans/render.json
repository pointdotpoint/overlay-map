{
 "name": "render",
 "runs": [
  {
   "name": "probe",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "cmd": "selftest",
     "timeout": 60
    },
    {
     "wait": 3
    },
    {
     "cmd": "open"
    },
    {
     "wait": 4
    },
    {
     "cmd": "zoomloop z 150 6"
    },
    {
     "await_state": "mode_done_z",
     "timeout": 280,
     "shoot_on": "hold",
     "shoot_gap": 3.0
    }
   ]
  }
 ]
}
