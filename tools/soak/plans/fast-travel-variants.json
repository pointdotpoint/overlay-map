{
 "name": "fast-travel-variants",
 "runs": [
  {
   "name": "control",
   "parts": [
    "scripts",
    "archive",
    "bootstrap",
    "autopilot"
   ],
   "repeats": 1,
   "steps": [
    {
     "wait": 8
    },
    {
     "shot": "world",
     "min_luma": 0.02
    },
    {
     "cmd": "open"
    },
    {
     "wait": 3
    },
    {
     "cmd": "focus_ft far",
     "expect": "^ok"
    },
    {
     "wait": 1.5
    },
    {
     "cmd": "selected",
     "expect": "^ft"
    },
    {
     "shot": "selected"
    },
    {
     "key": "KP_Decimal"
    },
    {
     "await_moved": 100,
     "timeout": 120
    },
    {
     "await_visible": 60,
     "min_luma": 0.02
    },
    {
     "wait": 10
    },
    {
     "shot": "arrived",
     "min_luma": 0.02
    }
   ]
  },
  {
   "name": "event",
   "parts": [
